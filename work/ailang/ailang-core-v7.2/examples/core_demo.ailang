// Núcleo AILang MVP
purge_after(50ms)

fn factorial(n) {
  if n <= 1 {
    return 1
  }
  return n * factorial(n - 1)
}

let xs = [1, 2, 3, 4, 5]
let total = 0
for n in xs {
  total = total + n
}

print("sum=", total)
print("5! =", factorial(5))

if total == 15 and factorial(5) == 120 {
  print("ok")
}
