// Módulos, try/catch y stdlib
import math
import listops
import json

fn safe_div(a, b) {
  try {
    if b == 0 {
      throw "division by zero"
    }
    return a / b
  } catch err {
    return null
  }
}

let nums = [1, 2, 3, 4, 5]
fn square(x) { return x * x }
let squares = listops.map(square, nums)

print("squares=", squares)
print("sum=", listops.sum(squares))
print("sqrt(16)=", math.sqrt(16))
print("safe_div 10/2=", safe_div(10, 2))
print("safe_div 10/0=", safe_div(10, 0))

let payload = json.dumps({"sum": listops.sum(squares)})
print("json=", payload)
