// Closures + clases + herencia + polimorfismo
class Animal {
  fn init(name) {
    self.name = name
  }
  fn speak() {
    return "..."
  }
  fn info() {
    return self.name + " says " + self.speak()
  }
}

class Dog extends Animal {
  fn speak() {
    return "woof"
  }
}

class Cat extends Animal {
  fn speak() {
    return "meow"
  }
  fn info() {
    return super.info() + "!"
  }
}

fn counter() {
  let n = 0
  return fn() {
    n = n + 1
    return n
  }
}

let pets = [Dog("Rex"), Cat("Mimi")]
for p in pets {
  print(p.info())
}

let c = counter()
print("count", c(), c())
