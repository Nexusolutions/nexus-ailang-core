{
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) {",
      "\t${3:return ${4:None}}",
      "}"
    ],
    "description": "Function declaration"
  },
  "Async Function": {
    "prefix": "afn",
    "body": [
      "async fn ${1:name}(${2:params}) {",
      "\t${0}",
      "}"
    ],
    "description": "Async function declaration"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\tfn init(${2:self}) {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Class declaration"
  },
  "Record": {
    "prefix": "record",
    "body": [
      "record ${1:Name} { ${2:fields} }"
    ],
    "description": "Record declaration"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:VARIANT1},",
      "\t${3:VARIANT2}",
      "}"
    ],
    "description": "Enum declaration"
  },
  "Interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "\tfn ${2:method}()",
      "}"
    ],
    "description": "Interface declaration"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "If statement"
  },
  "If-Else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "If-else statement"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t${0}",
      "}"
    ],
    "description": "While loop"
  },
  "For": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:iterable} {",
      "\t${0}",
      "}"
    ],
    "description": "For loop"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:pattern} => { ${3:body} }",
      "}"
    ],
    "description": "Match expression"
  },
  "Try-Catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t${1:body}",
      "} catch ${2:e} {",
      "\t${0:print(\"caught: \" + ${2})}",
      "}"
    ],
    "description": "Try-catch block"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import ${1:module}"
    ],
    "description": "Import statement"
  },
  "Generator": {
    "prefix": "gen",
    "body": [
      "fn ${1:name}() {",
      "\tyield ${2:value1}",
      "\tyield ${3:value2}",
      "}"
    ],
    "description": "Generator function"
  },
  "Channel": {
    "prefix": "chan",
    "body": [
      "let ${1:c} = channel()",
      "${1:c}.send(${2:value})",
      "let ${3:result} = ${1:c}.recv()"
    ],
    "description": "Channel send/recv"
  },
  "Spawn": {
    "prefix": "spawn",
    "body": [
      "spawn ${1:fn}(${2:args})"
    ],
    "description": "Spawn task"
  },
  "Print": {
    "prefix": "print",
    "body": [
      "print(${1:\"hello\"})"
    ],
    "description": "Print statement"
  },
  "Let": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${2:value}"
    ],
    "description": "Variable declaration"
  },
  "Const": {
    "prefix": "const",
    "body": [
      "const ${1:NAME} = ${2:value}"
    ],
    "description": "Constant declaration"
  },
  "Purge After": {
    "prefix": "purge",
    "body": [
      "purge_after(${1:50}ms)"
    ],
    "description": "Purge after directive"
  },
  "Brain Query": {
    "prefix": "brain",
    "body": [
      "import brain",
      "brain.query(\"${1:query text}\")"
    ],
    "description": "Brain cognitive query"
  }
}
